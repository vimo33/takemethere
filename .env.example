# Copy this file to .env and add at least one cloud API key.

# Recommended Google path for the installation:
# - Prompt expansion: current Gemini 3 Flash preview by default.
# - Image generation: Imagen 4 Standard by default for high-fidelity projection stills.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_PROMPT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# Faster/lower-cost image option:
# GEMINI_IMAGE_MODEL=imagen-4.0-fast-generate-001

# Highest-quality image option:
# GEMINI_IMAGE_MODEL=imagen-4.0-ultra-generate-001

# Optional OpenAI image path:
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_SIZE=2048x1024
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_FORMAT=jpeg

# Use equirectangular for 360 panorama tests.
WORLD_IMAGE_MODE=equirectangular

GENERATION_TIMEOUT_MS=60000
DEPTH_GPU=1
DEPTH_TIMEOUT_MS=45000
